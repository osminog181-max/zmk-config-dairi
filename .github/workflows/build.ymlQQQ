name: Build ZMK firmware

on:
  push:
    branches: [ main, master ]
  pull_request:
  workflow_dispatch:

jobs:
  build_dongle:
    uses: zmkfirmware/zmk/.github/workflows/build-user-config.yml@v0.3
    with:
      board: nice_nano_v2
      shield: dongle
      config: config

  build_keyboard:
    uses: zmkfirmware/zmk/.github/workflows/build-user-config.yml@v0.3
    with:
      board: nice_nano_v2
      shield: 3x10              # ← поменяй на реальное имя твоего щита клавиатуры
      config: config
