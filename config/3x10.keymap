#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define DEFAULT 0
#define NUMPAD 1
#define BLT 2

&mt {
    tapping-term-ms = <250>; // This is the value already set by default
};

/ {
    combos {
        compatible = "zmk,combos";

        /* ==================== CTRL+C, X, V ==================== */

        copy {
            timeout-ms = <45>;
            require-prior-idle-ms = <130>;
            slow-release;           // работает на всех слоях
            bindings = <&kp LC(C)>;
            key-positions = <39 22 23>;
        };

        cut {
            timeout-ms = <45>;
            require-prior-idle-ms = <130>;
            slow-release;
            bindings = <&kp LC(X)>;
            key-positions = <39 21 22>;
        };

        paste {
            timeout-ms = <45>;
            require-prior-idle-ms = <130>;
            slow-release;
            bindings = <&kp LC(V)>;
            key-positions = <39 23 24>;
        };

        /* ==================== Остальные комбо ==================== */

        backspace {
            timeout-ms = <60>;
            require-prior-idle-ms = <180>;   // чуть строже, чтобы не срабатывал случайно
            bindings = <&kp BACKSPACE>;
            key-positions = <7 6>;
        };

        print {
            timeout-ms = <50>;
            require-prior-idle-ms = <160>;
            layers = <0>;
            bindings = <&kp LC(P)>;
            key-positions = <1 2>;
        };

        insert {
            timeout-ms = <50>;
            require-prior-idle-ms = <160>;
            layers = <0>;
            bindings = <&kp INSERT>;
            key-positions = <1 3>;
        };

        qstn {
            bindings = <&kp LS(N7)>;
            key-positions = <6 7>;
        };

        rght_skbk {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <4 3>;
            layers = <0>;
        };

        lft_skbk {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <2 3>;
            layers = <0>;
        };

        to_numa {
            bindings = <&to 0>;
            key-positions = <36>;
        };

        to_simb {
            bindings = <&to 0>;
            key-positions = <48 50>;
        };

        space {
            bindings = <&kp SPACE>;
            key-positions = <8 7>;
        };

        entr {
            bindings = <&kp ENTER>;
            key-positions = <18 19>;
        };

        ctrl+shft {
            bindings = <&sk LS(LEFT_CONTROL)>;
            key-positions = <20 10>;
        };

        ctrl {
            bindings = <&sk LCTRL>;
            key-positions = <20 21>;
        };

        shft {
            bindings = <&sk LEFT_SHIFT>;
            key-positions = <10 11>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            bindings = <
&kp Q  &kp W  &kp E  &kp R  &mt GRAVE T  &kp Y  &kp U      &kp I           &kp O         &kp C_MUTE
&kp A  &kp S  &kp D  &kp F  &kp G        &kp H  &kp J      &kp K           &kp L         &kp P
&kp Z  &kp X  &kp C  &kp V  &kp B        &kp N  &mt SQT M  &mt LBKT COMMA  &mt RBKT DOT  &mt QMARK FSLH
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
            label = "base";
        };
    };
};
