#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define DEFAULT 0
#define NUMPAD 1
#define BLT 2

&mt { tapping-term-ms = <250>; };

/ {
    combos {
        compatible = "zmk,combos";

        copy {
            timeout-ms = <45>;
            require-prior-idle-ms = <130>;
            slow-release;
            layers = <1 2>;
            bindings = <&kp LC(C)>;
            key-positions = <27 38>;
        };

        cut {
            timeout-ms = <45>;
            require-prior-idle-ms = <130>;
            slow-release;
            layers = <1 2>;
            bindings = <&kp LC(X)>;
            key-positions = <26 38>;
        };

        paste {
            timeout-ms = <45>;
            require-prior-idle-ms = <130>;
            slow-release;
            layers = <1 2>;
            bindings = <&kp LC(V)>;
            key-positions = <28 38>;
        };

        backspace {
            timeout-ms = <60>;
            require-prior-idle-ms = <180>;
            layers = <1 2>;
            bindings = <&kp BACKSPACE>;
            key-positions = <4 3>;
        };

        print {
            timeout-ms = <50>;
            require-prior-idle-ms = <160>;
            layers = <0 1 2>;
            bindings = <&kp LC(P)>;
            key-positions = <1 2>;
        };

        insert {
            timeout-ms = <50>;
            require-prior-idle-ms = <160>;
            layers = <0 1 2>;
            bindings = <&kp INSERT>;
            key-positions = <1 3>;
        };

        qstn {
            bindings = <&kp LS(N7)>;
            key-positions = <6 7>;
        };

        rght_skbk {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <4 3>;
            layers = <0>;
        };

        lft_skbk {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <2 3>;
            layers = <0>;
        };

        calculator {
            bindings = <&kp C_AL_CALCULATOR>;
            key-positions = <5 41>;
            layers = <0 1>;
        };

        caps {
            bindings = <&kp CAPS>;
            key-positions = <37 40>;
            layers = <0 1>;
        };

        to_numa {
            bindings = <&to 1>;
            key-positions = <0 36>;
        };

        to_simb {
            bindings = <&to 2>;
            key-positions = <48 50>;
        };

        space {
            bindings = <&kp SPACE>;
            key-positions = <16 15>;
            layers = <1>;
        };
    };

    behaviors {
        hrm: hrm {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        modtap: modtap {
            compatible = "zmk,behavior-hold-tap";
            label = "MODTAP";
            #binding-cells = <2>;
            tapping-term-ms = <250>;
            bindings = <&mo>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            bindings = <
&trans      &kp Q            &kp W         &kp E            &kp R              &hrm GRAVE T    &kp Y      &kp U               &kp I                    &kp O                      &kp P                &trans
&kp ESCAPE  &hrm LEFT_WIN A  &hrm LCTRL S  &hrm LEFT_ALT D  &hrm LEFT_SHIFT F  &kp G           &kp H      &hrm RIGHT_SHIFT J  &hrm RIGHT_ALT K         &hrm RCTRL L               &hrm BACKSLASH SEMI  &kp BACKSPACE
&kp TAB     &kp Z            &kp X         &kp C            &kp V              &kp B           &kp N      &hrm SQT M          &hrm LEFT_BRACKET COMMA  &hrm RIGHT_BRACKET PERIOD  &hrm QUESTION SLASH  &kp DEL
&trans      &kp LEFT_ALT     &kp LCTRL                      &kp LEFT_GUI       &kp LEFT_SHIFT  &kp ENTER  &kp SPACE           &kp RIGHT_SHIFT          &kp RCTRL                  &kp RIGHT_GUI        &kp RIGHT_ALT  &trans
&mo 1       &kp C_MUTE       &mo 2
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
            label = "base";
        };

        numa {
            bindings = <
&trans  &kp KP_SUBTRACT  &kp N7  &kp N8  &kp NUMBER_9  &kp KP_DOT       &trans  &kp LEFT_ARROW  &kp UP_ARROW    &kp RIGHT_ARROW  &trans  &trans
&trans  &kp KP_PLUS      &kp N4  &kp N5  &kp N6        &kp NUMBER_0     &trans  &trans          &kp DOWN_ARROW  &trans           &trans  &trans
&trans  &kp KP_DIVIDE    &kp N1  &kp N2  &kp N3        &kp KP_MULTIPLY  &trans  &trans          &trans          &trans           &trans  &trans
&trans  &kp KP_EQUAL     &trans          &trans        &trans           &trans  &trans          &trans          &trans           &trans  &trans  &trans
&to 0   &trans           &trans
            >;

            label = "numa";
        };

        simbols {
            bindings = <
&kp F1  &kp F2  &kp F3          &mt LA(F4) F4  &kp F5        &kp F6        &kp LS(N7)            &kp LEFT_ARROW         &kp UP_ARROW    &kp RIGHT  &trans  &trans
&kp F7  &kp F8  &kp F9          &kp F10        &kp F11       &kp F12       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp DOWN_ARROW  &trans     &trans  &trans
&trans  &trans  &bt BT_CLR_ALL  &bt BT_SEL 2   &bt BT_SEL 1  &bt BT_SEL 0  &mt SLASH BACKSLASH   &kp EXCLAMATION        &kp UNDER       &trans     &trans  &trans
&trans  &trans  &trans                         &trans        &trans        &trans                &trans                 &trans          &trans     &trans  &trans  &trans
&to 0   &trans  &trans
            >;

            label = "sim_bt";
        };
    };
};
